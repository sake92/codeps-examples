amends "https://sake92.github.io/deder/config/v0.20.1/DederProject.pkl"


local const blogModules = new CreateScalaModules {
  root = "blog"
  id = "cli"
  template = new {
    scalaVersion = "3.8.4"
    semanticdbEnabled = true
  }
  testTemplate = (template.asTest()) {
    deps {
      "org.scalameta::munit:1.3.4"
    }
  }
}.get

modules {
    ...blogModules.all
}
